{
  "version": 3,
  "builds": [
    {
      "src": "mainstage-build/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*[.][a-zA-Z0-9]+)",
      "dest": "/mainstage-build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/mainstage-build/index.html"
    }
  ]
}
